{
  "name": "radiant-launcher-crack",
  "version": "1.0.0",
  "description": "Launcher Radiant Survie (Version Crack)",
  "author": "Radw123ytb",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.radiant.survie.crack",
    "productName": "Radiant Survie Crack",
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Radiant Survie Crack"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AstriazYT",
        "repo": "minecraft-rubis-launcher-crack",
        "releaseType": "release"
      }
    ],
    "forceCodeSigning": false
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "electron-updater": "^6.3.0",
    "fs-extra": "^11.2.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
